# syntax=docker/dockerfile:1
# Generated by build/render-dockerfiles.py; edit Dockerfile.fedora-44 and build/.
ARG BASE_IMAGE=ghcr.io/skynet-core/systemd:debian-13
ARG KWIN_VARIANT=source
FROM ${BASE_IMAGE} AS desktop-packages

ARG PLASMA_UID=1000
ARG PLASMA_GID=1000
ARG NOVNC_VERSION=1.7.0
ARG NOVNC_SHA256=b1003a11b6e6e8d8f7f5e5586daae7f8ca651d8aee0aa155ff9ac841c48f52c6

# PID 1 is root; every graphical process runs as plasma.
# hadolint ignore=DL3002
USER 0:0
SHELL ["/bin/bash", "-e", "-u", "-o", "pipefail", "-c"]
COPY build/install-packages build/create-user build/normalize-runtime build/websockify-requirements.txt /build-support/
COPY build/packages/debian/desktop.txt /build-support/packages/desktop.txt
RUN chmod +x /build-support/* \
    && /build-support/install-packages desktop \
    && /build-support/normalize-runtime \
    && /build-support/create-user \
    && curl --fail --location --retry 3 \
        "https://codeload.github.com/novnc/noVNC/tar.gz/refs/tags/v${NOVNC_VERSION}" \
        --output /tmp/novnc.tar.gz \
    && echo "${NOVNC_SHA256}  /tmp/novnc.tar.gz" | sha256sum --check - \
    && tar -xzf /tmp/novnc.tar.gz --strip-components=1 -C /opt/noVNC \
    && ln -s vnc.html /opt/noVNC/index.html \
    && rm /tmp/novnc.tar.gz

# Native plugins are built against this distro's exact Qt/KRFB libraries.
FROM desktop-packages AS input-source
SHELL ["/bin/bash", "-e", "-u", "-o", "pipefail", "-c"]
COPY build/packages/debian/input-build.txt /build-support/packages/input-build.txt
ARG KRFB_SOURCE_VERSION=26.08.2
ARG KRFB_SOURCE_SHA256=4f613500a2308f5b16b109ee4f113a69ea597cd03bdb19f8b6abd16ab914593e
RUN /build-support/install-packages input-build \
    && curl --fail --location --retry 3 \
        "https://codeload.github.com/KDE/krfb/tar.gz/refs/tags/v${KRFB_SOURCE_VERSION}" \
        --output /tmp/krfb.tar.gz \
    && echo "${KRFB_SOURCE_SHA256}  /tmp/krfb.tar.gz" | sha256sum --check - \
    && mkdir /krfb-source \
    && tar -xzf /tmp/krfb.tar.gz --strip-components=1 -C /krfb-source \
    && rm /tmp/krfb.tar.gz

FROM input-source AS input-build
COPY build/collect-artifacts /build-support/collect-artifacts
COPY native/ /src/
RUN cmake -S /src -B /build -G Ninja -DKRFB_SOURCE_DIR=/krfb-source \
    && cmake --build /build --parallel 2 \
    && /build-support/collect-artifacts input

FROM input-build AS compat-build
COPY compat/ /src/compat/
COPY test/egl-fence-stub.cpp test/egl-fence-test.cpp /src/tests/
RUN c++ -shared -fPIC -O2 /src/compat/xtest-paced.cpp -lX11 -ldl -o /xtest-paced.so \
    && c++ -shared -fPIC -O2 /src/compat/egl-fence-wait.cpp -ldl -o /egl-fence-wait.so \
    && c++ -shared -fPIC -O2 /src/compat/wayland-pointer-enter.cpp -lwayland-client -ldl -o /wayland-pointer-enter.so \
    && mkdir /fake-egl \
    && c++ -shared -fPIC -O2 /src/tests/egl-fence-stub.cpp -pthread -o /fake-egl/libEGL.so.1 \
    && c++ -O2 /src/tests/egl-fence-test.cpp -ldl -o /test-egl-fence \
    && LD_LIBRARY_PATH=/fake-egl python3 -c 'import os, subprocess; [subprocess.run(["/test-egl-fence", "/egl-fence-wait.so"], env={**os.environ, "FAKE_EGL_VENDOR": vendor}, timeout=5, check=True) for vendor in ("NVIDIA", "Mesa")]'

FROM input-source AS vnc-build
ARG TIGERVNC_VIEWER_VERSION=1.16.0
ARG TIGERVNC_VIEWER_SHA256=10512fc0254ae3bde41c19d18c15f7ebd8cd476261afe0611c41965d635d46e8
COPY build/packages/debian/vnc-build.txt /build-support/packages/vnc-build.txt
RUN /build-support/install-packages vnc-build
COPY build/collect-artifacts /build-support/collect-artifacts
COPY build/tigervnc-viewer /build-support/tigervnc-viewer
COPY patches/tigervnc-pointer-enter.patch /tmp/tigervnc-pointer-enter.patch
COPY patches/tigervnc-digest-sizes.patch /tmp/tigervnc-digest-sizes.patch
COPY patches/tigervnc-nettle4.patch /tmp/tigervnc-nettle4.patch
COPY patches/krfb-low-latency.patch /tmp/krfb-low-latency.patch
COPY native/framebuffer-geometry.h /krfb-source/krfb/framebuffer-geometry.h
COPY patches/krfb-existing-output.patch /tmp/krfb-existing-output.patch
COPY patches/krfb-initial-framebuffer.patch /tmp/krfb-initial-framebuffer.patch
COPY patches/krfb-loopback-relay.patch /tmp/krfb-loopback-relay.patch
RUN --mount=type=bind,from=desktop-packages,source=/,target=/desktop-baseline,ro \
    patch --batch --fuzz=0 -d /krfb-source -p1 < /tmp/krfb-low-latency.patch \
    && patch --batch --fuzz=0 -d /krfb-source -p1 < /tmp/krfb-existing-output.patch \
    && patch --batch --fuzz=0 -d /krfb-source -p1 < /tmp/krfb-initial-framebuffer.patch \
    && patch --batch --fuzz=0 -d /krfb-source -p1 < /tmp/krfb-loopback-relay.patch \
    && cmake -S /krfb-source -B /krfb-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && cmake --build /krfb-build --parallel 2 --target krfb-virtualmonitor krfb_framebuffer_pw \
    && /build-support/tigervnc-viewer \
    && /build-support/collect-artifacts vnc

# Build once against Debian's older glibc; the private ABI also runs on Ubuntu.
FROM ghcr.io/skynet-core/systemd:debian-13 AS kwin-build-dependencies
SHELL ["/bin/bash", "-e", "-u", "-o", "pipefail", "-c"]
COPY build/install-packages /build-support/install-packages
COPY build/packages/debian/kwin-build.txt /build-support/packages/kwin-build.txt
RUN bash /build-support/install-packages kwin-build
COPY build/kwin-6.8.2 build/kwin-6.8.2-sources.tsv /build-support/
FROM kwin-build-dependencies AS kwin-platform
COPY build/kwin-phases/platform.sh /build-support/kwin-phase-platform.sh
RUN /build-support/kwin-6.8.2 platform
FROM kwin-platform AS kwin-qtbase
COPY build/kwin-phases/qtbase.sh /build-support/kwin-phase-qtbase.sh
RUN /build-support/kwin-6.8.2 qtbase
FROM kwin-qtbase AS kwin-qtdeclarative
COPY build/kwin-phases/qtdeclarative.sh /build-support/kwin-phase-qtdeclarative.sh
RUN /build-support/kwin-6.8.2 qtdeclarative
FROM kwin-qtdeclarative AS kwin-qtmodules
COPY build/kwin-phases/qtmodules.sh /build-support/kwin-phase-qtmodules.sh
RUN /build-support/kwin-6.8.2 qtmodules
FROM kwin-qtmodules AS kwin-frameworks
COPY build/kwin-phases/frameworks.sh /build-support/kwin-phase-frameworks.sh
RUN /build-support/kwin-6.8.2 frameworks
FROM kwin-frameworks AS kwin-build
COPY build/packages/debian/kwin-final-build.txt /build-support/packages/kwin-final-build.txt
RUN bash /build-support/install-packages kwin-final-build
COPY build/kwin-vulkan-sources.tsv /build-support/kwin-vulkan-sources.tsv
RUN cat /build-support/kwin-vulkan-sources.tsv >> /build-support/kwin-6.8.2-sources.tsv
COPY build/kwin-phases/kwin.sh /build-support/kwin-phase-kwin.sh
RUN /build-support/kwin-6.8.2 kwin
FROM kwin-build AS kwin-artifacts
COPY build/kwin-client-sources.tsv /build-support/kwin-client-sources.tsv
RUN cat /build-support/kwin-client-sources.tsv >> /build-support/kwin-6.8.2-sources.tsv
COPY build/kwin-phases/collect.sh /build-support/kwin-phase-collect.sh
RUN /build-support/kwin-6.8.2 collect
# Select the dependency graph before building, so distro skips every source stage.
FROM kwin-artifacts AS kwin-source
RUN install -d /out/root/etc/plasma \
    && touch /out/root/etc/plasma/opengl-software-capture
RUN touch /out/root/etc/plasma/vnc-existing-output
FROM desktop-packages AS kwin-distro
RUN install -d /out/root/etc/plasma \
    && touch /out/root/etc/plasma/vnc-existing-output
# KWIN_VARIANT selects one of the two internal stages above.
# hadolint ignore=DL3006
FROM kwin-${KWIN_VARIANT} AS kwin-selected


FROM desktop-packages AS desktop
# Extend the inherited /init.d/init.sh; 400 runs before 501-systemd and 999-exec.
COPY init.d/modules/ /init.d/modules/
COPY bin/plasma-healthcheck /usr/local/bin/plasma-healthcheck
COPY libexec/ /usr/local/libexec/
COPY systemd/system/ /etc/systemd/system/
COPY config/ /etc/xdg/
COPY --from=compat-build /xtest-paced.so /egl-fence-wait.so /wayland-pointer-enter.so /usr/local/lib/plasma6/
COPY --from=kwin-selected /out/root/ /
RUN chmod +x /init.d/modules/*.sh /usr/local/bin/* /usr/local/libexec/* \
        /usr/local/libexec/plasma-backend/kwin_wayland \
    && command -v kscreen-doctor \
    && test -x /usr/bin/kwin_wayland \
    && test -x /usr/bin/kwin_x11 \
    && ldd /usr/bin/kwin_x11 >/tmp/kwin-x11.ldd \
    && ! grep -F 'not found' /tmp/kwin-x11.ldd \
    && rm /tmp/kwin-x11.ldd \
    && python3 -c 'import ctypes; ctypes.CDLL("libGLESv2.so.2")' \
    && if [[ -f /usr/lib/systemd/system/NetworkManager.service ]]; then \
        systemctl --root=/ disable NetworkManager.service; \
    fi \
    && systemctl mask getty.target console-getty.service systemd-udevd.service NetworkManager.service \
    && rm -rf /build-support

ENV MODULE_SYSTEMD_ENABLED=true \
    SYSTEMD_MASKED=NetworkManager.service \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display \
    DISPLAY_BACKEND=auto \
    DISPLAY_MODE=headless \
    DISPLAY_WIDTH=1920 \
    DISPLAY_HEIGHT=1080

EXPOSE 5900 6080
HEALTHCHECK --interval=10s --timeout=5s --start-period=90s --retries=6 \
    CMD ["/usr/local/bin/plasma-healthcheck"]
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/init.d/init.sh"]
CMD ["/usr/sbin/init", "--system"]

# Baseline target intentionally retains stock KRFB for reproducing regressions.
FROM desktop AS ui-baseline
COPY --from=input-build /build/plasma-clipboard /usr/local/libexec/plasma-clipboard
COPY --from=input-build /build/plasma-ui-fixture /usr/local/bin/plasma-ui-fixture

FROM desktop AS input-runtime
COPY --from=input-build /out/root/ /
RUN sed -i '/^X-KDE-Wayland-Interfaces=/s/$/,org_kde_kwin_fake_input/' \
        /usr/share/applications/org.kde.krfb.virtualmonitor.desktop

# Keep a working-input image with the distro KRFB for A/B benchmarks.
FROM input-runtime AS ui-perf-baseline
COPY --from=input-build /build/plasma-vnc-benchmark /usr/local/bin/plasma-vnc-benchmark

FROM input-runtime AS runtime
COPY --from=vnc-build /out/root/ /
RUN ldd /usr/bin/vncviewer >/tmp/vncviewer.ldd \
    && ! grep -F 'not found' /tmp/vncviewer.ldd \
    && rm /tmp/vncviewer.ldd

FROM runtime AS ui-test
COPY build/install-packages /build-support/install-packages
COPY build/packages/debian/browser.txt /build-support/packages/browser.txt
# DISTRO_BROWSER_ARTIFACTS
# Fedora defaults to user namespaces; preserve SUID fallback on restricted hosts.
RUN bash /build-support/install-packages browser \
    && if [ -f /etc/fedora-release ]; then \
        chown 0:0 /usr/lib64/chromium-browser/chrome-sandbox \
        && chmod 4755 /usr/lib64/chromium-browser/chrome-sandbox; \
    fi \
    && rm -rf /build-support
COPY --from=input-build /build/plasma-ui-fixture /usr/local/bin/plasma-ui-fixture
COPY --from=input-build /build/plasma-vnc-benchmark /usr/local/bin/plasma-vnc-benchmark

FROM runtime AS plasma6
