#!/usr/bin/python3
"""Make krfb's exported monitor the sole active output, including the desktop panel."""

import json
import os
import subprocess
import sys
import time


def outputs():
    result = subprocess.run(
        ["kscreen-doctor", "-j"], capture_output=True, text=True, timeout=5, check=True
    )
    items = json.loads(result.stdout)["outputs"]
    if any(not {"id", "name"}.issubset(item) for item in items):
        raise ValueError("Waiting for complete output information")
    # Some KScreen versions omit enabled for newly created virtual outputs.
    # An assigned nonzero output priority also identifies an active output.
    for item in items:
        item.setdefault("enabled", item.get("priority", 0) > 0)
    return items


def configured(items):
    active = [item for item in items if item["enabled"]]
    existing = (
        os.environ.get("PLASMA_SOFTWARE_CAPTURE") == "1"
        or os.environ.get("PLASMA_VNC_EXISTING_OUTPUT") == "1"
    )
    return (
        len(active) == 1
        and (existing or active[0]["name"] == "Virtual-Plasma")
        and active[0].get("pos") == {"x": 0, "y": 0}
    )


if os.environ["DISPLAY_BACKEND"] == "wayland":
    deadline = time.monotonic() + 60
    while True:
        try:
            items = outputs()
            if "--check" in sys.argv:
                sys.exit(0 if configured(items) else 1)
            if configured(items):
                break
            remote = next(
                (item for item in items if item["name"] == "Virtual-Plasma"), None
            )
            if remote:
                commands = [
                    f"output.{remote['id']}.enable",
                    f"output.{remote['id']}.position.0,0",
                    f"output.{remote['id']}.priority.1",
                ]
                commands += [
                    f"output.{item['id']}.disable"
                    for item in items
                    if item is not remote and item["enabled"]
                ]
                subprocess.run(["kscreen-doctor", *commands], check=True, timeout=5)
        except (subprocess.SubprocessError, ValueError) as error:
            if "--check" in sys.argv or time.monotonic() >= deadline:
                sys.exit(str(error))
        if time.monotonic() >= deadline:
            sys.exit("Timed out configuring the Plasma VNC monitor")
        time.sleep(0.25)
