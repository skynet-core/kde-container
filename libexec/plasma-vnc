#!/usr/bin/bash
set -euo pipefail
if [[ $DISPLAY_BACKEND == wayland ]]; then
    export PLASMA_KWIN_INPUT=1
    # Virtualmonitor requires no interactive portal approval.
    exec /usr/bin/krfb-virtualmonitor --name Plasma \
        --resolution "${DISPLAY_WIDTH}x${DISPLAY_HEIGHT}" --port 5900 \
        --password "$(cat /etc/plasma/vnc-password)"
fi
exec /usr/bin/x11vnc -display "$DISPLAY" -auth "$XAUTHORITY" \
    -rfbauth /etc/plasma/vnc-auth -rfbport 5900 -forever -shared -noxdamage
